{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleDetection": "force",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./types"]
  },
  "include": [
    "*.ts",
    "types/**/*.d.ts",
    "finished-goods/**/*.ts",
    "fabric/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
